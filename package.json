{
  "name": "hsp-mart-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "uv run --project backend uvicorn app.main:app --app-dir backend --reload --port 8000 --timeout-keep-alive 75",
    "dev:admin": "npm --prefix admin run dev",
    "test:api": "cd backend && DATABASE_URL=postgres://localhost:5432/hsp_giftos_test uv run pytest",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify:customization": "node scripts/verify-customization-foundation.mjs",
    "verify:brand-story": "node scripts/verify-brand-story-webm.mjs",
    "verify:ai-shopping": "npx --yes tsx --tsconfig tsconfig.json scripts/verify-ai-shopping.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/db/migrate.mts",
    "db:seed": "tsx --tsconfig tsconfig.json --env-file=.env.local scripts/db/seed.mts",
    "test:e2e": "playwright test",
    "db:gst-review": "cd backend && uv run --env-file ../.env.local python -I ../scripts/db/gst-review.py",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:prod": "E2E_PROD=1 playwright test",
    "test:e2e:all-browsers": "E2E_BROWSERS=chromium,firefox,webkit playwright test",
    "test:e2e:report": "playwright show-report",
    "test:all": "npm run test:api && npm run test:e2e"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "lucide-react": "^1.70.0",
    "next": "16.4.6",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  }
}
