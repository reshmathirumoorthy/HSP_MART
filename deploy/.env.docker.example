# Copy to deploy/.env.docker and fill in. Never commit the filled-in file.
# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -hex 24
CRON_SECRET=
REVALIDATE_SECRET=
# "production" sets secure cookies: serve over HTTPS. Use "development" only for a local trial on http://localhost.
ENVIRONMENT=production
# "1" shows sign-in codes on screen. Local trial only, never in production.
AUTH_DEV_OTP=
SITE_URL=https://hspmart.com
CORS_ORIGINS=https://admin.hspmart.com
HSP_GST_STATE=
CRON_INTERVAL_SECONDS=3600
# Providers (empty = simulated). See .env.example for the full list.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
EMAIL_PROVIDER_KEY=
EMAIL_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER_KEY=
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
VOYAGE_API_KEY=
ANTHROPIC_API_KEY=
