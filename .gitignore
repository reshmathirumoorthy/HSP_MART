/scripts/.tmp-brand-story-frame.png

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# product image backups / compose tooling artifacts
/public/images/products/_originals/
/public/images/products/variants/_originals/
