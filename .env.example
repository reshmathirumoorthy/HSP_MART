DATABASE_URL=postgres://localhost:5432/hsp_giftos
# Next.js → FastAPI (server-side calls and the /api/* forward). The API reads this same file.
BACKEND_URL=http://localhost:8000
# Storefront cache refresh after admin edits (catalogue / site content). Same secret on both apps.
REVALIDATE_SECRET=
NEXT_REVALIDATE_URL=http://localhost:3000/revalidate
# Admin app origin(s) allowed to call the API directly (comma-separated). Not needed when /api is proxied.
CORS_ORIGINS=http://localhost:5173
# 32+ random chars: `openssl rand -base64 32`
SESSION_SECRET=
# Dev only: show OTP codes on the login screen instead of sending SMS/email.
AUTH_DEV_OTP=1
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CRON_SECRET=
COMMISSION_TDS_BPS=200
RETURN_WINDOW_DAYS=7
EMAIL_PROVIDER_KEY=
SMS_PROVIDER_KEY=
WHATSAPP_TOKEN=
# Notifications: email via Resend-compatible API, WhatsApp Cloud API, SMS via MSG91 (DLT template per message)
EMAIL_FROM=
WHATSAPP_PHONE_NUMBER_ID=
# SMS_TEMPLATE_AUTH_OTP=
# Private file storage (artwork, delivery proofs). Without it, files go to ./.uploads (dev only).
BLOB_READ_WRITE_TOKEN=
# Accounting: Tally XML export. HSP's GST state enables CGST/SGST vs IGST split.
HSP_GST_STATE=
# Optional AI wording layer (drafts only; never touches money)
ANTHROPIC_API_KEY=
NEXT_PUBLIC_SITE_URL=
# Used by the API in links inside emails and messages.
SITE_URL=https://hspmart.com
# Set ENVIRONMENT=production on the API in production (disables simulated providers and dev codes).
ENVIRONMENT=development
# Tally ledgers for receipts: advances before dispatch, and the bank/clearing account
TALLY_ADVANCE_LEDGER="Customer Advances"
TALLY_BANK_LEDGER="Razorpay Clearing"
# Courier aggregator (Shiprocket). Empty = simulated courier (SIM-… AWBs, delivered after SIM_DELIVERY_DAYS)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION="Primary"
SIM_DELIVERY_DAYS=2
# Semantic product search (Voyage AI embeddings into pgvector). Empty = keyword + typo-tolerant search only
VOYAGE_API_KEY=
EMBEDDING_MODEL="voyage-3.5"
# Staff console URL: /admin on the store forwards here (React admin app)
ADMIN_APP_URL="http://localhost:5173"
# Share the session cookie across subdomains in production (e.g. ".hspmart.com"); empty = current host only
SESSION_COOKIE_DOMAIN=
